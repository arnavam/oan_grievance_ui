# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real values.
# See CLAUDE.md's "Required environment variables" table for full context.
# Every variable here is server-only unless it starts with NEXT_PUBLIC_, and a
# NEXT_PUBLIC_ variable must never hold a secret.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Base URL of oan_auth_service. Every /api/auth/* route and /api/proxy/*
# fails without it.
AUTH_API_BASE_URL=https://auth.example.org

# ---------------------------------------------------------------------------
# Optional — realtime (socket.io to oan_grievance_service)
# ---------------------------------------------------------------------------

# Leave REALTIME_PUBLIC_URL or REALTIME_SITE unset to turn realtime off; the UI then
# reads state through REST only. REALTIME_PUBLIC_URL must be ws:// or wss://.
# REALTIME_SITE is the Frappe site name (the folder under the bench's sites/),
# which names the socket.io namespace.
# Local bench example: 
# REALTIME_PUBLIC_URL=ws://localhost:3001
# REALTIME_UPSTREAM_URL=ws://localhost:9000
# REALTIME_SITE=mysite.localhost
# REALTIME_ALLOWED_ORIGINS=http://localhost:3000
# REALTIME_UPSTREAM_IS_FRAPPE=true
# REALTIME_PATH=/socket.io/

# ---------------------------------------------------------------------------
# Optional — reverse proxy / client IP resolution
# ---------------------------------------------------------------------------

# Reverse-proxy hops to trust when reading X-Forwarded-For. Must match the
# real infra in front of this app. 0 (default) trusts no forwarded header.
# TRUSTED_PROXY_HOPS=0

# ---------------------------------------------------------------------------
# Optional — per-route rate limits (requests per window); defaults shown
# ---------------------------------------------------------------------------

# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_LOGIN_WINDOW_MS=60000

# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_REGISTER_WINDOW_MS=60000

# The effective /api/auth/register ceiling whenever TRUSTED_PROXY_HOPS is unset
# (every visitor shares one bucket then) — see register/route.ts.
# RATE_LIMIT_REGISTER_SHARED_MAX=50
# RATE_LIMIT_REGISTER_SHARED_WINDOW_MS=60000

# RATE_LIMIT_REFRESH_MAX=20
# RATE_LIMIT_REFRESH_WINDOW_MS=60000

# RATE_LIMIT_LOGOUT_MAX=10
# RATE_LIMIT_LOGOUT_WINDOW_MS=60000

# RATE_LIMIT_FORGOT_PASSWORD_MAX=5
# RATE_LIMIT_FORGOT_PASSWORD_WINDOW_MS=60000

# RATE_LIMIT_RESET_PASSWORD_MAX=5
# RATE_LIMIT_RESET_PASSWORD_WINDOW_MS=60000

# RATE_LIMIT_HEARTBEAT_MAX=120
# RATE_LIMIT_HEARTBEAT_WINDOW_MS=60000

# RATE_LIMIT_LOCALE_MAX=30
# RATE_LIMIT_LOCALE_WINDOW_MS=60000

# RATE_LIMIT_REALTIME_CONFIG_MAX=30
# RATE_LIMIT_REALTIME_CONFIG_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Optional — idle-session timeout (milliseconds)
# ---------------------------------------------------------------------------

# Server-enforced cutoff and warning lead. If you override these, set the
# matching NEXT_PUBLIC_ pair to the same values, or the warning modal drifts
# from the real cutoff.
# IDLE_TIMEOUT_MS=900000
# IDLE_WARNING_LEAD_MS=60000
# NEXT_PUBLIC_IDLE_TIMEOUT_MS=900000
# NEXT_PUBLIC_IDLE_WARNING_LEAD_MS=60000
