{
  "name": "grievance-management-portal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:scan": "semgrep scan --config .semgrep/rules.yaml --metrics=on",
    "dev:realtime": "tsx watch realtime-gateway/server.ts",
    "build:realtime": "esbuild realtime-gateway/server.ts --bundle --platform=node --target=node24 --outfile=realtime-gateway/server.js",
    "start:realtime": "node realtime-gateway/server.js"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "esbuild": "^0.28.2",
    "http-proxy-3": "^2.0.1",
    "lucide-react": "^1.28.0",
    "next": "16.3.8",
    "next-intl": "^4.14.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
